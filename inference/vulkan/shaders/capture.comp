#version 450
// capture.comp: copy `count` floats from an act-temp offset into the SL
// history buffer (x or y slot for one layer + one position).
layout(local_size_x = 64) in;
layout(set = 0, binding = 2, std430) readonly buffer Act { float act[]; };
layout(set = 0, binding = 6, std430) buffer Hist { float hist[]; };
layout(push_constant) uniform PC {
    int src;    // act offset
    int dst;    // hist offset (slot base + pos*stride)
    int count;  // number of floats
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (int(i) >= pc.count) return;
    hist[pc.dst + int(i)] = act[pc.src + int(i)];
}
